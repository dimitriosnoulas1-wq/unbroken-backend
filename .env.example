# Comma-separated name:sha256 of each device token. Generate with: npm run token -- phone
DEVICE_TOKENS_SHA256=
# "mock" (offline sample output), "openai" (any OpenAI-compatible API), or "gemini"
PROVIDER=mock
# OpenAI-compatible API. When this is set, the server calls OpenAI even if PROVIDER=gemini.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Leave empty for the provider default (openai: gpt-4o-mini, gemini: gemini-3.5-flash-lite).
LLM_MODEL=
# Gemini. The key stays on this server: it is sent as the x-goog-api-key header and never
# placed in a URL, a log line, or the Android app. Required when PROVIDER=gemini.
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
PROVIDER_TIMEOUT_MS=20000
# Optional: YouTube Data API v3 key so «Παίξε … στο YouTube» opens the video itself instead of the results. Stays on the server.
YOUTUBE_API_KEY=
RATE_PER_MINUTE=20
RATE_PER_DAY=500
PORT=8787
# Set to 1 on Cloud Run. Failed-auth limits then use only the rightmost
# X-Forwarded-For address, which is the client the proxy observed.
TRUST_PROXY=0
