{
  "name": "unbroken-backend",
  "version": "2.0.0-rc1",
  "private": true,
  "type": "module",
  "description": "Unbroken AI planner: authenticated, rate-limited, schema-validated plan endpoint.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "token": "tsx scripts/new-device-token.ts",
    "fixtures": "tsx scripts/contract-fixtures.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
